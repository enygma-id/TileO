# Copy this file to .env and edit as needed.
# Docker Compose reads .env automatically; for native runs (npm start),
# the application loads .env via process.loadEnvFile() at startup.

# --- Server & Network Access ---
# TILEO_HOST=127.0.0.1  # Set 0.0.0.0 to access from other devices on local network (Wi-Fi/LAN)
# TILEO_PORT=8090
# TILEO_ALLOW_LAN=1     # Set 1 to allow local devices (192.168.x.x, 10.x.x.x, etc.) without token prompt

# --- Auth (optional for localhost; required before exposing to a network) ---
# Use a random token of at least 24 characters. Never commit your real .env.
TILEO_API_TOKEN=
# Optional canonical URL; local same-origin access still works when this differs.
TILEO_PUBLIC_ORIGIN=
# Set to 1 when TLS terminates at a reverse proxy and TILEO_PUBLIC_ORIGIN is not HTTPS.
# TILEO_SECURE_COOKIES=1
# Additional frontend origins, comma-separated, including scheme and port.
# TILEO_CORS_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
# Docker only: publish to LAN (use together with TILEO_ALLOW_LAN=1).
# TILEO_BIND_ADDRESS=0.0.0.0

# --- Data directory (default: tileo-ts/data, Docker: /data) ---
# TILEO_DATA_DIR=data

# --- Upload / queue ---
# TILEO_MAX_UPLOAD_MB=16384
# TILEO_QUEUE_LIMIT=20

# --- S3 / MinIO input (optional; empty keeps the feature disabled) ---
# JSON array. Keep real credentials only in .env or a deployment secret store.
# TILEO_S3_CONNECTIONS=[{"id":"archive","name":"GIS Archive","region":"ap-southeast-1","accessKeyId":"...","secretAccessKey":"...","allowedBuckets":["gis-data"],"allowedPrefixes":["cog/"],"allowUnversionedRemote":false}]
# MinIO example fields: "endpoint":"https://minio.example.test","forcePathStyle":true
# HTTP endpoints additionally require "allowInsecure":true and are intended for development only.
# Set allowUnversionedRemote=true only when allowed keys are operationally immutable.
# Public and presigned HTTPS URLs work without this list. Add exact hosts here
# only for private-network or development HTTP endpoints (SSRF allowlist).
# TILEO_REMOTE_URL_HOSTS=minio.internal.example,127.0.0.1
# TILEO_REMOTE_INSPECT_SECONDS=120
# TILEO_MAX_REMOTE_STAGE_MB=65536

# --- Worker resource limits ---
TILEO_THREADS=2
# Native per-tool private-bytes budget. GDAL parses a whole single-line GeoJSON
# into memory, so a ~500 MB GeoJSON can peak at ~6 GB. Raise this on machines
# with ample RAM (e.g. 12288 on a 32 GB host); keep it modest on small hosts.
# In Docker, TILEO_WORKER_MEM_LIMIT must be higher than TILEO_TOOL_MEMORY_MB.
TILEO_TOOL_MEMORY_MB=4096
# TILEO_WORKER_MEM_LIMIT=6g
TILEO_JOB_TIMEOUT_SECONDS=7200
TILEO_MAX_SCRATCH_MB=32768
# TILEO_MAX_TOP_LEVEL_TILES=2000000
# TILEO_DISK_RESERVE_MB=2048

# --- Vector Batch Processing ---
# TILEO_VECTOR_BATCH_MODE=off         # off: legacy ogrinfo/ogr2ogr; auto: batch for verified formats (GeoJSON); on: batch required
# TILEO_VECTOR_BATCH_FEATURES=10000  # Max features per batch
# TILEO_VECTOR_BATCH_MB=16           # Max payload size per batch in MiB
# TILEO_VECTOR_MAX_FEATURE_MB=16     # Max size of a single feature in MiB (cannot exceed TILEO_VECTOR_BATCH_MB)
# TILEO_VECTOR_BATCH_DELIVERY=file   # file: intermediate GeoJSONSeq on disk; stream: streaming pipeline

# --- Tool paths (native only; ignored inside Docker) ---
# Point to the folder containing executables, not the executable itself.
# Leave empty if already on PATH.
# TILEO_GDAL_BIN=D:\Kerja\TilesO\tools\gdal\bin\gdal\apps
# TILEO_TIPPECANOE_BIN=

# --- Basemap / Tile Provider (optional) ---
# Default uses authentic OpenStreetMap tiles served through the internal proxy (100% compliant, no 403 blocks).
# TILEO_BASEMAP_URL=/api/basemap/osm/{z}/{x}/{y}.png
# TILEO_MAP_API_KEY=
